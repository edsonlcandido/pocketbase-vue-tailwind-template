# Banco de dados do app no libSQL (Turso, sqld auto-hospedado ou proxy).
#
# A URL carrega o token na query string — por isso este arquivo é só o
# MODELO. O .env real é gitignored e nunca deve ser commitado.
#
# Formatos aceitos pelo driver:
#   https://<host>/dev/<namespace>/?authToken=<token>
#   libsql://<db>-<org>.turso.io?authToken=<token>
#
URL_LIBSQL_TURSO=https://libsql.ehtudo.app/dev/<namespace>/?authToken=<token>

# Opcional: segundo banco para o auxiliary.db (tabela _logs).
# Precisa ser um database SEPARADO — data.db e auxiliary.db têm as mesmas
# tabelas de sistema (_collections, _records) e uma colide com a outra.
# Se ficar vazio, o auxiliary.db vai para o disco local (/app/pb_data).
URL_LIBSQL_TURSO_AUX=
